{
  "name": " Phishcord - AI-Powered Phishing Email Detector (Chrome Extension)",
  "description": "Detects and alerts users about phishing emails in real-time",
  "version": "1.7",
  "manifest_version": 3,
  "action": {
    "default_title": "Click to open panel",
    "default_icon": "hello_extensions.png"
  },
  "host_permissions": [
    "http://127.0.0.1:5000/"
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "web_accessible_resources": [
  {
    "resources": ["popup.js", "audio.mp3"],
    "matches": ["http://*/*", "https://*/*"]
  }
]
}